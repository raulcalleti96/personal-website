# Supabase project settings (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Spotify app Client ID (developer.spotify.com/dashboard -> app -> Settings)
# Register these Redirect URIs on the app: <origin>/clients/focus for both
# your local dev origin and your production origin.
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id

# Google Analytics 4 measurement ID (analytics.google.com -> Admin -> Data streams)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Accounts that only see the Radio in the portal (comma-separated emails)
VITE_RADIO_ONLY_EMAILS=

# Accounts that see the "Empire-Test" app (comma-separated emails)
VITE_EMPIRE_TEST_EMAILS=
